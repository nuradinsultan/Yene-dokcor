# Django
SECRET_KEY=your-super-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.healthcare.et
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://*.healthcare.et

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=healthcare_db
DB_USER=healthcare_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432
DB_SSL_MODE=require

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@healthcare.et

# Cache
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://127.0.0.1:6379/1

# JWT
JWT_SECRET_KEY=your-jwt-secret-key

# SMS (Ethiopian providers)
SMS_BACKEND=apps.notifications.backends.ethiotel.EthioTeleSMSBackend
ETHIOTEL_API_KEY=your-ethiotel-api-key
ETHIOTEL_API_SECRET=your-ethiotel-api-secret

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
